# Portal settings (/opt/services/portal/.env, written by gen-env.sh)
DOMAIN=rep.local.inion
PORTAL_ENV=prod
# Role groups (copied from ../sso.env)
SSO_GROUP_USERS=portal-users
SSO_GROUP_PORTAL_ADMINS=portal-admins
SSO_GROUP_NETBOX_ADMINS=netbox-admins
SSO_GROUP_WIKI_ADMINS=wiki-admins
# Local development only (PORTAL_ENV=dev, no Nginx/SSO):
# PORTAL_DEV_USER=dev.user
# PORTAL_DEV_GROUPS=portal-users,portal-admins
