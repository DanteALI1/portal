# Keep LF line endings for everything that runs on the Linux server,
# even when committed from Windows (CRLF breaks bash: $'\r': command not found).
* text=auto eol=lf
*.sh text eol=lf
*.py text eol=lf
*.conf text eol=lf
*.service text eol=lf
*.yml text eol=lf
*.php text eol=lf
*.png binary
*.ico binary
*.woff binary
*.woff2 binary
