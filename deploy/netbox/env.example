# Copy to .env (install.sh generates secrets automatically)
VERSION=v4.7-5.1.1

# PostgreSQL
POSTGRES_DB=netbox
POSTGRES_USER=netbox
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES

# NetBox DB (must match POSTGRES_*)
DB_HOST=postgres
DB_NAME=netbox
DB_USER=netbox
DB_PASSWORD=CHANGE_ME_POSTGRES
DB_WAIT_DEBUG=1

# Redis / Valkey-compatible
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=CHANGE_ME_REDIS
REDIS_SSL=false
REDIS_INSECURE_SKIP_TLS_VERIFY=false

REDIS_CACHE_HOST=redis-cache
REDIS_CACHE_PORT=6379
REDIS_CACHE_DATABASE=1
REDIS_CACHE_PASSWORD=CHANGE_ME_REDIS_CACHE
REDIS_CACHE_SSL=false
REDIS_CACHE_INSECURE_SKIP_TLS_VERIFY=false

# NetBox app
SECRET_KEY=CHANGE_ME_SECRET_KEY_MIN_50_CHARS_XXXXXXXXXXXXXXXXXXXX
ALLOWED_HOSTS=rep.local.inion localhost 127.0.0.1
BASE_PATH=netbox/
CORS_ORIGIN_ALLOW_ALL=True
SKIP_SUPERUSER=false
SUPERUSER_NAME=admin
SUPERUSER_EMAIL=admin@local.inion
SUPERUSER_PASSWORD=CHANGE_ME_ADMIN
SUPERUSER_API_TOKEN=CHANGE_ME_API_TOKEN
LOGIN_REQUIRED=true
GRAPHQL_ENABLED=true
METRICS_ENABLED=false
MEDIA_ROOT=/opt/netbox/netbox/media
RELEASE_CHECK_URL=https://api.github.com/repos/netbox-community/netbox/releases
