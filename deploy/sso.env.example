# Shared single sign-on settings -> /opt/services/sso.env (not secret).
# gen-env.sh copies these values into every service .env; re-run install.sh after a change.
DOMAIN=rep.local.inion

# Role groups (Keycloak groups or directory groups when LDAP/AD is connected)
SSO_GROUP_USERS=portal-users
SSO_GROUP_PORTAL_ADMINS=portal-admins
SSO_GROUP_NETBOX_ADMINS=netbox-admins
SSO_GROUP_WIKI_ADMINS=wiki-admins
