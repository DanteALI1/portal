# oauth2-proxy settings. gen-env.sh creates the real .env.
DOMAIN=rep.local.inion
# Must equal OIDC_CLIENT_SECRET in ../keycloak/.env
OAUTH2_PROXY_CLIENT_SECRET=CHANGE_ME
# 32 random bytes, base64 (openssl rand -base64 32 | tr -- '+/' '-_')
OAUTH2_PROXY_COOKIE_SECRET=CHANGE_ME
OAUTH2_PROXY_REDIS_PASSWORD=CHANGE_ME
# Role groups (copied from ../sso.env by gen-env.sh)
SSO_GROUP_USERS=portal-users
SSO_GROUP_PORTAL_ADMINS=portal-admins
SSO_GROUP_NETBOX_ADMINS=netbox-admins
SSO_GROUP_WIKI_ADMINS=wiki-admins
